# Copy to .env for local development: cp .env.example .env
# Every variable is optional — the defaults are enough to run locally.

# --- Django -----------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# --- HTTPS (only applied when DEBUG=false) ----------------------------------
# Opt-in: enable it only behind a TLS-terminating proxy. A local runserver also
# has DEBUG off, and turning this on there would redirect to https://localhost.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use SQLite locally.
# Local Postgres (docker-compose):
#   DATABASE_URL=postgres://bookstore:bookstore@localhost:5432/bookstore
# Supabase (production) — use the *pooler* host, it is IPv4-reachable:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSL_REQUIRE=true
DB_USE_PGBOUNCER=true
DB_CONN_MAX_AGE=0

# --- API behaviour ----------------------------------------------------------
DEFAULT_PAGE_SIZE=20
DEFAULT_LOCAL_CURRENCY=EUR
DEFAULT_MARGIN_PERCENTAGE=40
ISBN_VALIDATE_CHECKSUM=false
CORS_ALLOW_ALL_ORIGINS=true

# Optional write protection. Empty = the API is fully open (default).
# With a value set, POST/PUT/PATCH/DELETE require the header:
#   X-API-Key: <this value>
# Reads stay public either way.
API_KEY=

# --- Exchange rate provider -------------------------------------------------
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_TIMEOUT=5
# Rates are cached in the database when DATABASE_URL is set (shared by every
# gunicorn worker) and in memory otherwise.
EXCHANGE_RATE_CACHE_TTL=600
# JSON object used when the provider is unreachable. Snapshot: 2026-07-31.
FALLBACK_EXCHANGE_RATES={"USD":"1","EUR":"0.869","GBP":"0.745","MXN":"17.36","COP":"3200.63","ARS":"1490.84","CLP":"933.41","PEN":"3.39","BRL":"5.09","DOP":"58.03","VES":"746.63"}

# --- Container startup (read by scripts/entrypoint.sh) ----------------------
# Apply migrations before starting the server.
RUN_MIGRATIONS=true
# Load the 6 sample books on start. Idempotent: it never duplicates rows.
SEED_DATABASE=false
# gunicorn sizing and the port it binds to.
WEB_CONCURRENCY=3
WEB_THREADS=2
WEB_TIMEOUT=60
PORT=8000

# Set automatically by Render; added to ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS.
# RENDER_EXTERNAL_HOSTNAME=
