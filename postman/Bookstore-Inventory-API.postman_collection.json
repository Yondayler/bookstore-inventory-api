    {
      "name": "CRUD",
      "item": [
        {
          "name": "Create book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"El Quijote (ejemplar de prueba)\",\n  \"author\": \"Miguel de Cervantes\",\n  \"isbn\": \"{{isbn}}\",\n  \"cost_usd\": 15.99,\n  \"stock_quantity\": 25,\n  \"category\": \"Literatura Clásica\",\n  \"supplier_country\": \"ES\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": "Crea un libro. El ISBN se genera aleatoriamente (ISBN-13 con dígito de control válido) para que la petición pueda ejecutarse tantas veces como haga falta sin chocar con un libro ya existente. El `id` devuelto queda guardado en la variable `book_id`."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// ISBN-13 aleatorio con dígito de control correcto.",
                  "const body = '978' + Array.from({ length: 9 }, () => Math.floor(Math.random() * 10)).join('');",
                  "let sum = 0;",
                  "for (let i = 0; i < 12; i++) { sum += Number(body[i]) * (i % 2 === 0 ? 1 : 3); }",
                  "pm.collectionVariables.set('isbn', body + ((10 - (sum % 10)) % 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('book_id', body.id);",
                  "  pm.test('selling_price_local empieza en null', () => pm.expect(body.selling_price_local).to.eql(null));",
                  "  pm.test('el ISBN enviado es el que devuelve la API', () => pm.expect(body.isbn).to.eql(pm.collectionVariables.get('isbn')));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
