        {
          "name": "Delete book",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "description": "Borra el libro creado por `Create book`. Solo se ejecuta si esa petición se lanzó antes, para no borrar los libros de ejemplo del entorno desplegado."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('book_id')) {",
                  "  throw new Error(\"Ejecuta primero 'CRUD → Create book': esta petición solo borra el libro creado por la colección.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));",
                  "if (pm.response.code === 204) { pm.collectionVariables.set('book_id', ''); }"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    }
  ]
}
