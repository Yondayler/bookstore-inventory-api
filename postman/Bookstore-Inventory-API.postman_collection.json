    {
      "name": "Cálculo de precio",
      "item": [
        {
          "name": "Calculate price (defaults: EUR, 40%)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}/calculate-price",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}",
                "calculate-price"
              ]
            },
            "description": "Obtiene la tasa USD→moneda local en tiempo real, aplica el margen del 40%, guarda `selling_price_local` y devuelve el detalle del cálculo."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('book_id')) {",
                  "  throw new Error(\"Ejecuta primero 'CRUD → Create book': el cálculo escribe el precio en el libro creado.\");",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('incluye el detalle del cálculo', () => {",
                  "  pm.expect(b).to.have.all.keys('book_id','cost_usd','exchange_rate','cost_local','margin_percentage','selling_price_local','currency','calculation_timestamp','rate_source','rate_provider','fallback_used');",
                  "});",
                  "pm.test('precio = coste local + margen', () => {",
                  "  const esperado = Math.round(b.cost_usd * b.exchange_rate * (1 + b.margin_percentage / 100) * 100) / 100;",
                  "  pm.expect(Math.abs(b.selling_price_local - esperado)).to.be.below(0.02);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
