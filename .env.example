# Copy to .env for local development: cp .env.example .env
# Every variable is optional — the defaults are enough to run locally.

# --- Django -----------------------------------------------------------------
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL empty to use SQLite locally.
# Local Postgres (docker-compose):
#   DATABASE_URL=postgres://bookstore:bookstore@localhost:5432/bookstore
# Supabase (production) — use the *pooler* host, it is IPv4-reachable:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
DB_SSL_REQUIRE=true
DB_USE_PGBOUNCER=true
DB_CONN_MAX_AGE=0

# --- API behaviour ----------------------------------------------------------
DEFAULT_PAGE_SIZE=20
DEFAULT_LOCAL_CURRENCY=EUR
DEFAULT_MARGIN_PERCENTAGE=40
ISBN_VALIDATE_CHECKSUM=false
CORS_ALLOW_ALL_ORIGINS=true

# --- Exchange rate provider -------------------------------------------------
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_TIMEOUT=5
EXCHANGE_RATE_CACHE_TTL=600
# JSON object used when the provider is unreachable.
FALLBACK_EXCHANGE_RATES={"USD":"1","EUR":"0.92","GBP":"0.78","MXN":"18.50","COP":"4050","ARS":"980","CLP":"950","PEN":"3.75","BRL":"5.45","DOP":"59.50","VES":"36.50"}
